# Social Content Hub — backend. Copy to server/.env and fill in.

PORT=5000

# Where OAuth callbacks send the browser when the dance finishes. Defaults to
# http://localhost:5173. On Render this MUST be the deployed SPA's origin.
FRONTEND_URL=http://localhost:5173

# Browser origins allowed to call this API with credentials, comma-delimited.
# Defaults to FRONTEND_URL + http://localhost:5173.
#
# Credentials are required — the OAuth state cookie is set on the /connect
# response and the browser only keeps it when the response names this origin
# explicitly. `*` cannot be used together with credentials and is never sent.
# CORS_ORIGINS=https://your-app.vercel.app

# Supabase — Project Settings → API. The service role key bypasses RLS, so it
# stays server-side and is never shipped to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-supabase-jwt-secret

# Project Settings → Database → Connection string → Session pooler (port 5432).
# Must be the session pooler, not the transaction one on 6543 — see
# src/config/prisma.ts.
DATABASE_URL="postgresql://postgres.your-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# LinkedIn app credentials (Sprint 3). linkedin.com/developers → your app → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/auth/linkedin/callback

# ─── Instagram (Sprint 5.1) ──────────────────────────────────────────────────
#
# FlowPost uses "Instagram API with Instagram Login" — the model where the
# member signs in with Instagram and no Facebook Page is required. It is what
# the app's "Manage messaging & content on Instagram" use case configures.
#
# IMPORTANT: these are the **Instagram** App ID and Secret, from
#   developers.facebook.com → your app → Instagram → API setup with Instagram
#   login → "Instagram app ID" / "Instagram app secret"
#
# They are NOT the Meta App ID and App Secret shown on the app's own Settings →
# Basic page. Those are different numbers and belong to the Facebook Login
# model. Pasting them here produces an authorization screen that fails with a
# generic error naming nothing, which is painful to diagnose.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must match a URI registered under Instagram → API setup with Instagram login
# → "Business login settings" → Redirect URIs, character for character.
INSTAGRAM_REDIRECT_URI=http://localhost:5000/auth/instagram/callback

# ─── Facebook Pages (Sprint 5.2) ─────────────────────────────────────────────
#
# The other Meta authentication model: "Facebook Login". The member signs in
# with Facebook, picks a Page they manage, and FlowPost publishes to that Page.
#
# IMPORTANT: these are the **Meta** App ID and App Secret, from
#   developers.facebook.com → your app → Settings → Basic
#
# They are NOT the Instagram pair above. Same app, different numbers, different
# login model — swapping them produces a consent screen that fails with a
# generic error naming nothing.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Must match a URI registered under Facebook Login → Settings → Valid OAuth
# Redirect URIs, character for character.
#
# NOTE: "Enforce HTTPS" is on by default for every app created since March 2018
# and cannot be turned off. A plain http:// URI — localhost included — may be
# rejected or silently upgraded to https:// by Meta, in which case the callback
# never reaches this server. For local development, put an HTTPS tunnel
# (ngrok, cloudflared) in front of port 5000 and register that URL instead.
FACEBOOK_REDIRECT_URI=http://localhost:5000/auth/facebook/callback

# Business Login Configuration ID. REQUIRED for business-type Meta apps —
# which is what this app is, because it hosts the Instagram business use case.
#
# Meta serves business apps the "Facebook Login for Business" dialog, which
# takes its permissions from a dashboard configuration rather than from the
# `scope` parameter. Invoking it without a config_id produces
#   "Sorry, something went wrong." + HTTP 500
# with no error body at all.
#
# Get one from: App Dashboard → Facebook Login for Business → Configurations →
# Create configuration → choose the Pages asset + the three permissions above.
#
# Leave empty only on a consumer-type app, where `scope` is the right
# mechanism. Run `npm run diagnose:facebook` — it reports which dialog Meta
# will actually serve for this app.
FACEBOOK_CONFIG_ID=

# Optional. Comma-delimited override for the requested permissions; empty means
# the publish-only default:
#   pages_show_list,pages_read_engagement,pages_manage_posts
# Unknown values are dropped rather than sent. Here because App Review can
# approve a narrower set than first requested, and matching it should not need
# a redeploy.
# FACEBOOK_SCOPES=

# Graph API version, shared by every Meta surface (Instagram and Facebook Pages
# today; Threads later). Meta ships a version roughly quarterly and sunsets each
# one after about two years, so this is an environment variable rather than a
# constant — same reasoning as LINKEDIN_API_VERSION.
META_API_VERSION=v25.0

# AES-256 key for OAuth token encryption at rest. Exactly 32 bytes, base64.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored token undecryptable — users must reconnect.
TOKEN_ENCRYPTION_KEY=

# ─── AI generation (Sprint 4.1) ──────────────────────────────────────────────
# Which text provider to use. Only 'gemini' is implemented; see
# server/src/ai/providers/ to add another.
AI_PROVIDER=gemini

# Google AI Studio → Get API key (https://aistudio.google.com/apikey).
#
# This key is read by the backend only. It must NEVER be given a VITE_ prefix
# or copied into the root .env — a VITE_ variable is compiled into the browser
# bundle, and the whole point of POST /api/ai/caption is that the browser
# cannot see this value.
GEMINI_API_KEY=

# Vendor-level default, reported by /api/ai/status. Workloads do NOT inherit
# it — each role below has its own default, so a deployment that only sets
# GEMINI_MODEL still gets the model-per-workload routing.
GEMINI_MODEL=gemini-3.1-pro-preview

# One model per workload. Flash writes and looks, Pro Preview reasons,
# Flash-Lite does chores (alt text). Defaults shown; uncomment to override.
# (There is no gemini-3.1-flash on the API — 3.6 is the newest stable flash.)
# GEMINI_CAPTION_MODEL=gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.6-flash
# GEMINI_MARKETING_MODEL=gemini-3.1-pro-preview
# GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
# GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Thinking depth for Gemini 3.x models (low | high). Gemini 3 cannot disable
# thinking — a budget of 0 is rejected with "This model only works in thinking
# mode" — so "low" is the fast option, right for caption writing.
GEMINI_THINKING_LEVEL=low

# Thinking tokens for Gemini 2.5 models only (3.x uses GEMINI_THINKING_LEVEL).
# 0 disables the reasoning pass; -1 lets the model decide. Ignored by models
# that do not support thinking.
GEMINI_THINKING_BUDGET=0
