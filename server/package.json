{
  "name": "social-content-hub-backend",
  "version": "1.0.0",
  "description": "Express backend for Social Content Hub",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm install --prefix .. && npm run db:generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "npm --prefix .. run db:generate",
    "verify:sprint2": "ts-node-dev --transpile-only --quiet src/scripts/verify-sprint2.ts",
    "verify:sprint33": "ts-node-dev --transpile-only --quiet src/scripts/verify-sprint33.ts",
    "verify:sprint41": "ts-node-dev --transpile-only --quiet src/scripts/verify-sprint41.ts",
    "verify:sprint42": "ts-node-dev --transpile-only --quiet src/scripts/verify-sprint42.ts",
    "verify:publish": "ts-node-dev --transpile-only --quiet src/scripts/verify-publish.ts",
    "verify:sprint43": "ts-node-dev --transpile-only --quiet src/scripts/verify-sprint43.ts",
    "verify:sprint51": "ts-node-dev --transpile-only --quiet src/scripts/verify-sprint51.ts",
    "verify:instagram": "ts-node-dev --transpile-only --quiet src/scripts/verify-instagram-publish.ts",
    "verify:facebook": "ts-node-dev --transpile-only --quiet src/scripts/verify-facebook-publish.ts",
    "diagnose:facebook": "ts-node-dev --transpile-only --quiet src/scripts/diagnose-facebook-oauth.ts",
    "verify:models": "ts-node-dev --transpile-only --quiet src/scripts/verify-model-routing.ts",
    "verify:contexts": "ts-node-dev --transpile-only --quiet src/scripts/verify-context-isolation.ts",
    "verify:platform-media": "ts-node-dev --transpile-only --quiet src/scripts/verify-platform-media.ts",
    "verify:analytics": "ts-node --transpileOnly src/scripts/verify-analytics-live.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.2",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.22.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.20.4",
    "prisma": "^7.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
