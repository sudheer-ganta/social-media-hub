// Social Content Hub — database schema, managed by Prisma Migrate.
//
// Two consumers, two access paths:
//   • the React frontend reads/writes `posts` and `brand_voices` through
//     supabase-js (PostgREST), so those models keep snake_case *field* names
//     that match the JSON the browser sees.
//   • the Express backend (server/) reads/writes the integration tables
//     through Prisma Client. Those models use idiomatic camelCase fields
//     @map'd onto snake_case columns, and are never exposed to PostgREST.
//
// Not expressible in the Prisma schema language (they live in the
// migration SQL instead — see prisma/migrations/*/migration.sql):
//   • the CHECK constraint on `status`
//   • the FK from `created_by` to Supabase's `auth.users`
//   • Row Level Security policies
//   • the `updated_at` trigger
//   • the expression index on ai_studio_output -> 'meta' ->> 'status'
//   • the partial unique index enforcing one default brand voice per user
//   • the CHECK constraints on `context_type` (posts and social_accounts)
//   • the COALESCE-based unique index on social_accounts
//     (user, provider, account, context) — replaces the old three-column unique
// Because of that, always create new migrations with
//   npx prisma migrate dev --create-only
// and review the generated SQL before applying.

datasource db {
  provider = "postgresql"
}

// Generated into the backend's source tree, because the backend is the only
// Prisma Client consumer. CommonJS to match server/tsconfig.json.
generator client {
  provider     = "prisma-client"
  output       = "../server/src/generated/prisma"
  moduleFormat = "cjs"
}

model Post {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  caption      String     @default("")
  image_url    String     @default("")
  platforms    Json       @default("[]")
  status       PostStatus @default(DRAFT)
  publish_date DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  publish_time DateTime   @default(dbgenerated("'09:00:00'::time without time zone")) @db.Time(6)

  /// The canonical UTC instant the scheduler fires on, or null for a post that
  /// has never been scheduled. The *only* column the worker reads — publish_date
  /// and publish_time above are wall-clock fields the browser writes and every
  /// list, filter and calendar reads, and a browser in the wrong timezone must
  /// never be able to move a publish.
  scheduled_at DateTime? @db.Timestamptz(6)

  /// The IANA zone the member scheduled in, e.g. `Asia/Kolkata`. Preserved so
  /// editing a schedule reopens on the wall clock they chose rather than on a
  /// UTC instant retranslated into whatever zone the browser is in today. DST is
  /// resolved when `scheduled_at` is computed — on the server, never here.
  timezone String?
  created_by   String     @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)

  // Publishing context. A post belongs to exactly one context; the publisher
  // resolves the social account from these two columns, never from the request,
  // so a personal post can never go out through a brand connection. The CHECK
  // tying brand_id to context_type = 'brand', and the RLS clause proving the
  // brand belongs to the author, live in migration SQL.
  context_type String  @default("personal")
  brand_id     String? @db.Uuid
  brand        Brand?  @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  // Composer fields. music is display metadata (no network API attaches
  // audio); cta and link_url are Brand-mode fields.
  music    String?
  cta      String?
  link_url String?

  /// How each selected network frames the one uploaded image, as fractions of
  /// the original: {"instagram":{"ratio":"4:5","x":0.1,"y":0,"w":0.8,"h":1,
  /// "zoom":1}, …}. Null means "deliver the asset whole", which is what every
  /// post did before this existed. The upload itself is never rewritten — the
  /// crop becomes a Cloudinary delivery transformation at publish time.
  /// See src/utils/crop.ts.
  platform_media Json?

  /// Every image attached to this post, in the order it should be published:
  /// [{"id":"…","url":"…","type":"image","width":1600,"height":900,
  ///   "crop":{"ratio":"4:5","x":0.1,"y":0,"w":0.8,"h":1,"zoom":1}}, …]
  ///
  /// Null on every post written before the multi-image composer existed. Those
  /// read as a single item derived from `image_url`, which is still written on
  /// every save as a mirror of `media[0].url` — so the AI pipeline, the post
  /// list, the dashboard and any client that predates this column keep working
  /// against one image exactly as they did.
  ///
  /// `type` is present so video can be added later without reshaping the
  /// column; today the composer and every provider accept `"image"` only.
  /// The crop is per item here, where `platform_media` above is per network —
  /// the two coexist: an item's own crop frames it, and a post that has never
  /// been through the multi-image composer still frames per network.
  media Json?

  // AI pipeline. Written by the backend AI module via the posts API —
  // see server/src/ai/ and src/services/posts.service.ts.
  ai_status           String    @default("pending")
  approved            Boolean   @default(false)
  platform_results    Json      @default("{}")
  published_at        DateTime? @db.Timestamptz(6)
  ai_caption          String?
  ai_hashtags         String[]
  ai_platform_content Json?

  // AI Marketing Studio. Two versioned JSONB envelopes — see src/ai/types.ts
  // for the shapes. New studio capabilities add a key inside ai_studio_output
  // rather than a column here, so they need no migration.
  ai_studio_input  Json? // AiStudioInput  — the settings a generation was asked for
  ai_studio_output Json? // AiStudioOutput — the result it produced

  // Per-network publish attempts, one row per provider. Supersedes the
  // `platform_results` JSON blob for anything the backend publishes itself.
  post_platforms PostPlatform[]

  @@index([created_by])
  @@index([status])
  @@index([publish_date])
  @@index([created_at(sort: Desc)])
  @@index([approved])
  @@index([brand_id])
  @@map("posts")
}

/// A first-class Brand — a publishing context with its own connected social
/// accounts and posts, distinct from BrandVoice (a reusable AI writing style).
/// Browser-facing via PostgREST (per-user RLS in migration SQL); the backend
/// reads it via Prisma to validate ownership when a connection or publish
/// claims to act for a brand. Deleting a brand CASCADEs to its connections
/// (tokens must not outlive the brand) and its posts.
model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String   @default("")
  website     String   @default("")
  created_by  String   @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  social_accounts SocialAccount[]
  posts           Post[]
  generated_assets GeneratedAsset[]

  @@unique([created_by, name])
  @@index([created_by])
  @@map("brands")
}

/// Reusable Brand Voice profiles for the AI Marketing Studio. The `voice`
/// payload is snapshotted into each post's ai_studio_input at generation time,
/// so editing a profile never rewrites the settings of past posts.
model BrandVoice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  voice      Json     @default("{}") // BrandVoice — see src/ai/types.ts
  is_default Boolean  @default(false)
  created_by String   @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([created_by, name])
  @@index([created_by])
  @@index([created_at(sort: Desc)])
  @@map("brand_voices")
}

/// Reusable Creative DNA profiles — the visual sibling of BrandVoice. Where
/// BrandVoice describes how a brand writes, this describes how it looks:
/// photography style, composition, lighting, mood, colour, logo/product
/// treatment. The `dna` payload is resolved the same way BrandVoice is —
/// user-set fields win, image analysis fills gaps — by
/// `server/src/ai/brand/creative-dna.ts`. Never forced on the user as a
/// questionnaire: a first save is normally auto-populated from an uploaded
/// asset and then confirmed/adjusted.
model CreativeDna {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  dna        Json     @default("{}") // CreativeDnaInput — see src/ai/types.ts
  is_default Boolean  @default(false)
  created_by String   @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([created_by, name])
  @@index([created_by])
  @@index([created_at(sort: Desc)])
  @@map("creative_dna")
}

/// Reusable "Creative Style Profile" — saved output of reference-led creative
/// generation (spec: "Show FlowPost what you like"). A SIBLING to CreativeDna,
/// not a field on it: a member can hold several style profiles independent of
/// brand identity, each one a ReferenceStyleProfile (visual language extracted
/// from uploaded references — see server/src/ai/types.ts) reusable across
/// future generations without re-uploading. Same shape/RLS pattern as
/// CreativeDna, including the one-default-per-owner partial unique index.
model ReferenceStyleProfile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  profile    Json     @default("{}") // ReferenceStyleProfile — see src/ai/types.ts
  is_default Boolean  @default(false)
  created_by String   @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([created_by, name])
  @@index([created_by])
  @@index([created_at(sort: Desc)])
  @@map("reference_style_profiles")
}

/// How one member writes, in one publishing context.
///
/// Not a cache of their captions and not a copy of anything. The payload holds
/// measured distributions (how long, how punctuated, how often a mix of
/// scripts) and short behavioural descriptions — never vocabulary. A profile
/// that remembered the words somebody uses would produce captions that reuse
/// them, which is a template generator wearing a style profile. See
/// `server/src/ai/style/types.ts` for the shape and the guard that enforces it.
///
/// One row per (user, context, brand): a member has one personal profile and
/// one per brand they post for, all built by the same code. The uniqueness
/// index needs COALESCE over the nullable brand_id, so it lives in migration
/// SQL alongside the RLS statement — this table is backend-only and, like
/// social_accounts, has RLS enabled with no policies so PostgREST cannot see it.
model StyleProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  contextType String  @default("personal") @map("context_type")
  brandId     String? @map("brand_id") @db.Uuid

  /// StyleProfile — see server/src/ai/style/types.ts.
  profile Json

  /// How many weighted signals went into it. Below STYLE_MIN_SAMPLES the
  /// profile reports itself as unusable and the prompt takes the cold-start
  /// path instead of rendering a personality inferred from four captions.
  sampleCount Int @default(0) @map("sample_count")

  /// The posts already folded in, so a rebuild knows what is new and a deleted
  /// post can be spotted as a reason to rebuild.
  sourcePostIds String[] @default([]) @map("source_post_ids") @db.Uuid

  builtAt   DateTime @default(now()) @map("built_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("style_profiles")
}

enum GeneratedAssetStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("generated_asset_status")
}

/// Provenance, explicit rather than inferred from `parentAssetId` being set —
/// business logic lives in a field, not in "does this row happen to have a
/// parent". AI_GENERATED covers a fresh generation and every campaign
/// variation; AI_REFINED is only ever set by `refine()`.
enum GeneratedAssetSource {
  AI_GENERATED
  AI_REFINED

  @@map("generated_asset_source")
}

/// One AI-generated creative, from FlowPost's brand-native image pipeline.
///
/// Backend-only, same pattern as `StyleProfile`: RLS enabled with no
/// PostgREST policies, written and read exclusively through
/// `server/src/routes/creative.routes.ts` — the frontend never queries this
/// table directly, since the Gemini/Cloudinary keys that produced these rows
/// live only on the backend.
///
/// Never overwritten. Regenerate and Refine each insert a new row rather than
/// mutating one, linked back to where they came from via `parentAssetId` —
/// that lineage is the generation history the UI's Result screen reads, and
/// `campaignId` groups the linked variations one creative direction produced
/// (hero/product/lifestyle/...) without inventing a second grouping table.
model GeneratedAsset {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  contextType String  @default("personal") @map("context_type")
  brandId     String? @map("brand_id") @db.Uuid
  brand       Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  /// The member's raw natural-language request, verbatim.
  prompt String

  /// The structured CreativeDirection actually used to generate — internal,
  /// never shown raw to the user. See server/src/ai/generators/creative-direction.generator.ts.
  creativeBrief Json @map("creative_brief")

  /// Input asset URLs (product photo, logo, references) used for this
  /// generation, if any. Empty for a no-asset request.
  sourceAssetUrls String[] @default([]) @map("source_asset_urls")

  imageUrl           String? @map("image_url")
  cloudinaryPublicId  String? @map("cloudinary_public_id")
  /// From Cloudinary's own upload response — the account already measured
  /// this asset, so nothing here re-derives it.
  width  Int?
  height Int?
  format String?

  provider String @default("gemini")
  model    String

  source GeneratedAssetSource @default(AI_GENERATED)
  status GeneratedAssetStatus @default(PENDING)

  /// Groups the linked variations one creative direction produced.
  campaignId String? @map("campaign_id") @db.Uuid

  /// The asset this one was regenerated or refined from, if any.
  parentAssetId String?          @map("parent_asset_id") @db.Uuid
  parentAsset   GeneratedAsset?  @relation("AssetLineage", fields: [parentAssetId], references: [id], onDelete: SetNull)
  children      GeneratedAsset[] @relation("AssetLineage")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([campaignId])
  @@index([parentAssetId])
  @@map("generated_assets")
}

// ─── Integrations (backend-only, via Prisma Client) ──────────────────────────
//
// These three tables are written exclusively by the Express backend. They have
// RLS enabled with *no* policies, which makes them invisible to the anon and
// authenticated PostgREST roles — the browser can never read an OAuth token,
// even with a valid session. The backend connects as the database owner, which
// bypasses RLS. Anything the UI needs about a connection is served by the API,
// which returns profile fields only and never the encrypted token columns.

/// One connected social network per user, per provider account.
/// Tokens are stored as AES-256-GCM ciphertext — see
/// server/src/services/encryption.service.ts. Nothing writes them in plaintext.
model SocialAccount {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  provider          String
  providerAccountId String  @map("provider_account_id")
  displayName       String? @map("display_name")
  username          String?
  profileImage      String? @map("profile_image")

  encryptedAccessToken  String  @map("encrypted_access_token")
  encryptedRefreshToken String? @map("encrypted_refresh_token")

  /// When the access token stops working. Null for providers that don't expire.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  status SocialAccountStatus @default(CONNECTED)

  /// Scopes the provider actually granted, which can be narrower than we asked
  /// for. Drives the Permissions list and the "publishing enabled" check, so it
  /// is read at render time rather than re-derived from provider config.
  scopes String[] @default([])

  /// The provider API version this connection was established against, e.g.
  /// LinkedIn's `202401`. Kept so a future breaking API change can be spotted
  /// per-connection instead of assumed global.
  providerVersion String? @map("provider_version")

  /// Last time the provider confirmed the profile — set by a successful connect
  /// or by Refresh Connection. Distinct from `updatedAt`, which any write moves.
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)

  /// Last time the connection's health was checked, successfully or not. A
  /// failed check updates this but not `lastSyncedAt`.
  lastHealthCheck DateTime? @map("last_health_check") @db.Timestamptz(6)

  /// Which publishing context this connection serves: 'personal' or 'brand'.
  /// A brand connection always carries its brandId (CHECK in migration SQL).
  /// The same provider account may be connected once per context, so the
  /// reconnect-idempotency unique index includes the context — it lives in
  /// migration SQL because it needs COALESCE over the nullable brand_id.
  contextType String  @default("personal") @map("context_type")
  brandId     String? @map("brand_id") @db.Uuid
  brand       Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Publications that went out through this connection. SET NULL on delete,
  /// never CASCADE: disconnecting an account must not erase the record that a
  /// post was published, and the publication's own context lives on the post.
  publications PostPlatform[]

  /// Account-level history. Also SET NULL — see AccountMetricSnapshot, which
  /// carries its own copy of the scope so a disconnect cannot orphan it.
  metricSnapshots AccountMetricSnapshot[]

  syncState MetricSyncState?

  @@index([userId])
  @@index([userId, provider])
  @@index([provider, status])
  @@index([brandId])
  @@map("social_accounts")
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR

  @@map("social_account_status")
}

/// Append-only audit trail. Written through activity.service.ts, never
/// directly — see server/src/services/activity.service.ts.
model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  provider  String?
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("activity_logs")
}

/// One publish attempt per post per network. `publishedId` is the provider's
/// own id for the created post (LinkedIn's URN, for example), which is what
/// later lets us link out to it or delete it.
model PostPlatform {
  id           String        @id @default(uuid()) @db.Uuid
  postId       String        @map("post_id") @db.Uuid
  provider     String
  status       PublishStatus @default(PENDING)
  publishedId  String?       @map("published_id")

  /// The live post's URL on the network, captured at publish time.
  ///
  /// Stored rather than derived because not every network's permalink can be
  /// rebuilt from `publishedId`. LinkedIn's can — it is the URN on the end of a
  /// fixed prefix. Instagram's cannot: it carries an opaque shortcode that only
  /// Meta knows, returned by a follow-up read that needs a live access token.
  /// Null for rows published before this column existed, and for any publish
  /// where the permalink lookup failed; the UI hides the link in both cases.
  permalink String? @map("permalink")

  errorMessage String?       @map("error_message")

  /// Something worth telling the member about a publication that *succeeded*.
  ///
  /// Distinct from `errorMessage` on purpose, and the distinction is the whole
  /// reason this column exists: an error means nothing was published and the
  /// row is FAILED, where a notice means the post is live and something about
  /// it differs from what was composed. Reusing `errorMessage` would put that
  /// sentence everywhere failures are rendered and make a successful post look
  /// broken.
  ///
  /// Today it carries exactly one thing: X refused the attached media and the
  /// text was published without it. Null on every other publication, which is
  /// almost all of them.
  ///
  /// Written for a member and safe to display — the provider composes it and
  /// never puts a status code or a response body in it.
  notice String? @map("notice")

  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  /// How many times the scheduler has *claimed* this destination. Incremented
  /// by the claim itself, not by the outcome, so a worker that dies mid-publish
  /// still burns an attempt and cannot loop forever.
  attempts Int @default(0)

  /// When the last claim happened. The stale-claim reaper reads this: a row
  /// still PUBLISHING long after its last attempt belongs to a process that no
  /// longer exists.
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(6)

  /// When this destination becomes due. Null means "not scheduled" — a manual
  /// publish never sets it, and the worker's query cannot see the row at all.
  /// A first run holds the post's `scheduled_at`; a retry holds the backoff.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)

  /// When this destination actually went out. `posts.published_at` cannot say
  /// "Instagram at 09:30, LinkedIn at 09:31 after one retry".
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  /// Which connection this went out through.
  ///
  /// `provider` alone stopped being enough once a member could hold a personal
  /// and a brand LinkedIn at the same time: analytics has to present *the token
  /// that owns the post* to read its metrics, and re-deriving that from the
  /// post's context at read time is a guess that goes wrong the moment an
  /// account is disconnected and reconnected.
  ///
  /// Nullable, and SET NULL rather than CASCADE on delete: rows published
  /// before this column existed have no answer, and a disconnect must leave the
  /// publication record standing. A null here means "cannot be re-synced",
  /// never "was not published".
  socialAccountId String?        @map("social_account_id") @db.Uuid
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  /// What the member asked to publish, before anything was sent.
  ///
  /// The *requested* format, where `mediaType` below is the *observed* one.
  /// Both are kept because they disagree in ways worth seeing: a member choosing
  /// "Reel" and Instagram filing it as something else is only visible if the
  /// request survives alongside the observation.
  ///
  /// Reuses `MediaType` rather than declaring a parallel enum — the six words
  /// mean the same thing on both sides, which is what lets analytics group
  /// requested against observed without a translation table. `OTHER` is never
  /// written here: it is an answer a network can give, not a choice a member
  /// can make.
  ///
  /// Null on every row written before the composer offered a choice, and never
  /// backfilled. Null is an instruction, not a gap — it means "resolve this the
  /// way it was resolved before this column existed", which is the rule that
  /// keeps already-scheduled posts publishing exactly as they would have.
  /// See `publish/services/content-type.ts`.
  contentType MediaType? @map("content_type")

  /// What this publication actually *is* on that network.
  ///
  /// Per publication, not per post: the same FlowPost content is a REEL on
  /// Instagram and an IMAGE on LinkedIn, and media-type performance is
  /// meaningless if both are filed under one label. Null until something says
  /// otherwise — an unknown format is not a TEXT post.
  mediaType MediaType? @map("media_type")

  /// Whether `mediaType` came from the network or from what was uploaded.
  ///
  /// The network is the authority: a video posted to Instagram comes back as a
  /// REEL whatever we sent, and only Instagram knows that. False means the
  /// value was inferred at publish time from the attached media, and a later
  /// sync is allowed to overwrite it. True means the network told us, and
  /// nothing may downgrade it back to an inference.
  mediaTypeFromPlatform Boolean @default(false) @map("media_type_from_platform")

  post            Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)
  metricSnapshots PostMetricSnapshot[]

  @@unique([postId, provider])
  @@index([postId])
  @@index([status])
  @@index([nextAttemptAt])
  @@index([socialAccountId])
  /// The analytics read path: "the last N things this connection published".
  @@index([status, publishedAt(sort: Desc)])
  @@map("post_platforms")
}

/// What a publication is, normalised across networks.
///
/// A closed list on purpose. `OTHER` is the honest home for a format we have no
/// column for yet — inventing an enum value per network would put
/// `INSTAGRAM_REEL` and `X_VIDEO` in the same comparison and make "which format
/// works best" unanswerable, which is the entire point of storing this.
enum MediaType {
  TEXT
  IMAGE
  VIDEO
  CAROUSEL
  REEL
  STORY
  /// A real format we do not model. The platform's own label is kept in the
  /// snapshot's `raw`, so this is recoverable rather than lost.
  OTHER

  @@map("media_type")
}

/// Where a snapshot's numbers came from.
///
/// There is deliberately no `UNAVAILABLE` member. A metric a network does not
/// report is a NULL *column*, not a differently-sourced row — and every metric
/// column below is nullable for exactly that reason. Collapsing "we asked and
/// the answer was none of your business" into `0` is the failure this whole
/// table exists to prevent.
enum MetricSource {
  /// Read from the network's own analytics API.
  PLATFORM_API
  /// Computed by FlowPost from other stored values. Nothing writes this yet.
  DERIVED

  @@map("metric_source")
}

/// One observation of one publication's performance, at one moment.
///
/// **Append-only.** A post's numbers an hour after publishing and a week after
/// publishing are two facts, not one fact revised — and the difference between
/// them is the only place a post's lifecycle, and eventually a best-time
/// recommendation, can come from. Nothing in the codebase updates a row here.
///
/// Every metric is nullable and every one means the same thing when null: this
/// network does not report it, or did not report it this time. Readers must
/// propagate the null rather than defaulting it.
///
/// `raw` keeps the network's untouched response. Meta is removing Page Insights
/// metrics in June 2026 and has already replaced `impressions` with `views`;
/// keeping the original payload is what lets history be re-normalised after a
/// shape change instead of being thrown away.
model PostMetricSnapshot {
  id             String @id @default(uuid()) @db.Uuid
  postPlatformId String @map("post_platform_id") @db.Uuid

  /// Floored to the hour by the sync service — see the unique index below.
  capturedAt DateTime     @map("captured_at") @db.Timestamptz(6)
  source     MetricSource @default(PLATFORM_API)

  impressions Int?
  reach       Int?
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  reposts     Int?
  saves       Int?
  clicks      Int?
  videoViews  Int? @map("video_views")
  watchTimeMs Int? @map("watch_time_ms")

  /// The network's response, unmodified.
  raw Json?

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)

  /// Idempotency. A sync re-run inside the same hour collides here and is
  /// skipped, so a retry after a partial failure cannot double-count.
  @@unique([postPlatformId, capturedAt])
  @@index([postPlatformId, capturedAt(sort: Desc)])
  @@map("post_metric_snapshots")
}

/// One observation of an account's audience, at one moment.
///
/// The scope columns (`userId`, `contextType`, `brandId`, `provider`,
/// `providerAccountId`) are duplicated from the connection deliberately. A
/// member who disconnects and reconnects Instagram gets a new `social_accounts`
/// row, and without these the follower history from before the reconnect would
/// become unattributable — which is the same as losing it. They are also what
/// lets the context filter run as a column predicate rather than a join, so
/// Personal can never accidentally read a brand's audience.
model AccountMetricSnapshot {
  id String @id @default(uuid()) @db.Uuid

  /// Null once the connection it was taken through has been deleted. The
  /// snapshot survives; only the pointer goes.
  socialAccountId String?        @map("social_account_id") @db.Uuid
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  userId            String  @map("user_id") @db.Uuid
  contextType       String  @default("personal") @map("context_type")
  brandId           String? @map("brand_id") @db.Uuid
  provider          String
  providerAccountId String  @map("provider_account_id")

  capturedAt DateTime     @map("captured_at") @db.Timestamptz(6)
  source     MetricSource @default(PLATFORM_API)

  followers    Int?
  following    Int?
  postCount    Int? @map("post_count")
  impressions  Int?
  reach        Int?
  profileViews Int? @map("profile_views")

  raw Json?

  /// One observation per account per hour. Same reasoning as the post snapshot.
  @@unique([userId, provider, providerAccountId, capturedAt])
  @@index([userId, contextType, brandId, capturedAt(sort: Desc)])
  @@map("account_metric_snapshots")
}

/// Where one connection's analytics sync has got to.
///
/// One row per connection, updated in place — this is *state*, not history, and
/// it is the only table in this feature that is not append-only. Deleted with
/// the connection, because a sync cursor for a connection that no longer exists
/// is not worth keeping.
model MetricSyncState {
  socialAccountId String        @id @map("social_account_id") @db.Uuid
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  /// Last attempt, successful or not.
  lastSyncAt DateTime? @map("last_sync_at") @db.Timestamptz(6)
  /// Last attempt that actually stored something.
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz(6)

  consecutiveFailures Int     @default(0) @map("consecutive_failures")
  lastError           String? @map("last_error")

  /// Set when the network says to back off. Nothing reads it yet; the periodic
  /// worker that will is Phase 2.
  rateLimitedUntil DateTime? @map("rate_limited_until") @db.Timestamptz(6)

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("metric_sync_state")
}

enum PublishStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  /// Set by a cancel on a destination that had not started. Terminal: the
  /// worker's due query matches PENDING only, so a cancelled row can never be
  /// claimed.
  CANCELLED

  @@map("publish_status")
}

/// The publishing lifecycle of a post. Labels are lowercase in the database so
/// the existing supabase-js frontend — which reads and writes 'draft',
/// 'scheduled', 'published' as plain strings — keeps working unchanged.
/// QUEUED is new in Sprint 2: handed to the publisher, not yet in flight.
enum PostStatus {
  DRAFT      @map("draft")
  SCHEDULED  @map("scheduled")
  QUEUED     @map("queued")
  PUBLISHING @map("publishing")
  PUBLISHED  @map("published")
  FAILED     @map("failed")
  /// Some destinations went out and some did not. The honest answer for a post
  /// that reached Instagram and not X — FAILED would hide a live post, and
  /// PUBLISHED would hide a failure the member has to act on.
  PARTIALLY_PUBLISHED @map("partially_published")
  /// A schedule the member called off before it fired. Terminal: the worker
  /// never executes it and it cannot be rescheduled without a new schedule.
  CANCELLED  @map("cancelled")

  @@map("post_status")
}
