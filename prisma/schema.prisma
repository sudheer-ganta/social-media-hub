// Social Content Hub — database schema, managed by Prisma Migrate.
//
// Two consumers, two access paths:
//   • the React frontend reads/writes `posts` and `brand_voices` through
//     supabase-js (PostgREST), so those models keep snake_case *field* names
//     that match the JSON the browser sees.
//   • the Express backend (server/) reads/writes the integration tables
//     through Prisma Client. Those models use idiomatic camelCase fields
//     @map'd onto snake_case columns, and are never exposed to PostgREST.
//
// Not expressible in the Prisma schema language (they live in the
// migration SQL instead — see prisma/migrations/*/migration.sql):
//   • the CHECK constraint on `status`
//   • the FK from `created_by` to Supabase's `auth.users`
//   • Row Level Security policies
//   • the `updated_at` trigger
//   • the expression index on ai_studio_output -> 'meta' ->> 'status'
//   • the partial unique index enforcing one default brand voice per user
//   • the CHECK constraints on `context_type` (posts and social_accounts)
//   • the COALESCE-based unique index on social_accounts
//     (user, provider, account, context) — replaces the old three-column unique
// Because of that, always create new migrations with
//   npx prisma migrate dev --create-only
// and review the generated SQL before applying.

datasource db {
  provider = "postgresql"
}

// Generated into the backend's source tree, because the backend is the only
// Prisma Client consumer. CommonJS to match server/tsconfig.json.
generator client {
  provider     = "prisma-client"
  output       = "../server/src/generated/prisma"
  moduleFormat = "cjs"
}

model Post {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  caption      String     @default("")
  image_url    String     @default("")
  platforms    Json       @default("[]")
  status       PostStatus @default(DRAFT)
  publish_date DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  publish_time DateTime   @default(dbgenerated("'09:00:00'::time without time zone")) @db.Time(6)
  created_by   String     @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)

  // Publishing context. A post belongs to exactly one context; the publisher
  // resolves the social account from these two columns, never from the request,
  // so a personal post can never go out through a brand connection. The CHECK
  // tying brand_id to context_type = 'brand', and the RLS clause proving the
  // brand belongs to the author, live in migration SQL.
  context_type String  @default("personal")
  brand_id     String? @db.Uuid
  brand        Brand?  @relation(fields: [brand_id], references: [id], onDelete: Cascade)

  // Composer fields. music is display metadata (no network API attaches
  // audio); cta and link_url are Brand-mode fields.
  music    String?
  cta      String?
  link_url String?

  /// How each selected network frames the one uploaded image, as fractions of
  /// the original: {"instagram":{"ratio":"4:5","x":0.1,"y":0,"w":0.8,"h":1,
  /// "zoom":1}, …}. Null means "deliver the asset whole", which is what every
  /// post did before this existed. The upload itself is never rewritten — the
  /// crop becomes a Cloudinary delivery transformation at publish time.
  /// See src/utils/crop.ts.
  platform_media Json?

  /// Every image attached to this post, in the order it should be published:
  /// [{"id":"…","url":"…","type":"image","width":1600,"height":900,
  ///   "crop":{"ratio":"4:5","x":0.1,"y":0,"w":0.8,"h":1,"zoom":1}}, …]
  ///
  /// Null on every post written before the multi-image composer existed. Those
  /// read as a single item derived from `image_url`, which is still written on
  /// every save as a mirror of `media[0].url` — so the AI pipeline, the post
  /// list, the dashboard and any client that predates this column keep working
  /// against one image exactly as they did.
  ///
  /// `type` is present so video can be added later without reshaping the
  /// column; today the composer and every provider accept `"image"` only.
  /// The crop is per item here, where `platform_media` above is per network —
  /// the two coexist: an item's own crop frames it, and a post that has never
  /// been through the multi-image composer still frames per network.
  media Json?

  // AI pipeline. Written by the backend AI module via the posts API —
  // see server/src/ai/ and src/services/posts.service.ts.
  ai_status           String    @default("pending")
  approved            Boolean   @default(false)
  platform_results    Json      @default("{}")
  published_at        DateTime? @db.Timestamptz(6)
  ai_caption          String?
  ai_hashtags         String[]
  ai_platform_content Json?

  // AI Marketing Studio. Two versioned JSONB envelopes — see src/ai/types.ts
  // for the shapes. New studio capabilities add a key inside ai_studio_output
  // rather than a column here, so they need no migration.
  ai_studio_input  Json? // AiStudioInput  — the settings a generation was asked for
  ai_studio_output Json? // AiStudioOutput — the result it produced

  // Per-network publish attempts, one row per provider. Supersedes the
  // `platform_results` JSON blob for anything the backend publishes itself.
  post_platforms PostPlatform[]

  @@index([created_by])
  @@index([status])
  @@index([publish_date])
  @@index([created_at(sort: Desc)])
  @@index([approved])
  @@index([brand_id])
  @@map("posts")
}

/// A first-class Brand — a publishing context with its own connected social
/// accounts and posts, distinct from BrandVoice (a reusable AI writing style).
/// Browser-facing via PostgREST (per-user RLS in migration SQL); the backend
/// reads it via Prisma to validate ownership when a connection or publish
/// claims to act for a brand. Deleting a brand CASCADEs to its connections
/// (tokens must not outlive the brand) and its posts.
model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String   @default("")
  website     String   @default("")
  created_by  String   @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  social_accounts SocialAccount[]
  posts           Post[]

  @@unique([created_by, name])
  @@index([created_by])
  @@map("brands")
}

/// Reusable Brand Voice profiles for the AI Marketing Studio. The `voice`
/// payload is snapshotted into each post's ai_studio_input at generation time,
/// so editing a profile never rewrites the settings of past posts.
model BrandVoice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  voice      Json     @default("{}") // BrandVoice — see src/ai/types.ts
  is_default Boolean  @default(false)
  created_by String   @default(dbgenerated("auth.uid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([created_by, name])
  @@index([created_by])
  @@index([created_at(sort: Desc)])
  @@map("brand_voices")
}

// ─── Integrations (backend-only, via Prisma Client) ──────────────────────────
//
// These three tables are written exclusively by the Express backend. They have
// RLS enabled with *no* policies, which makes them invisible to the anon and
// authenticated PostgREST roles — the browser can never read an OAuth token,
// even with a valid session. The backend connects as the database owner, which
// bypasses RLS. Anything the UI needs about a connection is served by the API,
// which returns profile fields only and never the encrypted token columns.

/// One connected social network per user, per provider account.
/// Tokens are stored as AES-256-GCM ciphertext — see
/// server/src/services/encryption.service.ts. Nothing writes them in plaintext.
model SocialAccount {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  provider          String
  providerAccountId String  @map("provider_account_id")
  displayName       String? @map("display_name")
  username          String?
  profileImage      String? @map("profile_image")

  encryptedAccessToken  String  @map("encrypted_access_token")
  encryptedRefreshToken String? @map("encrypted_refresh_token")

  /// When the access token stops working. Null for providers that don't expire.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  status SocialAccountStatus @default(CONNECTED)

  /// Scopes the provider actually granted, which can be narrower than we asked
  /// for. Drives the Permissions list and the "publishing enabled" check, so it
  /// is read at render time rather than re-derived from provider config.
  scopes String[] @default([])

  /// The provider API version this connection was established against, e.g.
  /// LinkedIn's `202401`. Kept so a future breaking API change can be spotted
  /// per-connection instead of assumed global.
  providerVersion String? @map("provider_version")

  /// Last time the provider confirmed the profile — set by a successful connect
  /// or by Refresh Connection. Distinct from `updatedAt`, which any write moves.
  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)

  /// Last time the connection's health was checked, successfully or not. A
  /// failed check updates this but not `lastSyncedAt`.
  lastHealthCheck DateTime? @map("last_health_check") @db.Timestamptz(6)

  /// Which publishing context this connection serves: 'personal' or 'brand'.
  /// A brand connection always carries its brandId (CHECK in migration SQL).
  /// The same provider account may be connected once per context, so the
  /// reconnect-idempotency unique index includes the context — it lives in
  /// migration SQL because it needs COALESCE over the nullable brand_id.
  contextType String  @default("personal") @map("context_type")
  brandId     String? @map("brand_id") @db.Uuid
  brand       Brand?  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([userId, provider])
  @@index([provider, status])
  @@index([brandId])
  @@map("social_accounts")
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR

  @@map("social_account_status")
}

/// Append-only audit trail. Written through activity.service.ts, never
/// directly — see server/src/services/activity.service.ts.
model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  provider  String?
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@map("activity_logs")
}

/// One publish attempt per post per network. `publishedId` is the provider's
/// own id for the created post (LinkedIn's URN, for example), which is what
/// later lets us link out to it or delete it.
model PostPlatform {
  id           String        @id @default(uuid()) @db.Uuid
  postId       String        @map("post_id") @db.Uuid
  provider     String
  status       PublishStatus @default(PENDING)
  publishedId  String?       @map("published_id")

  /// The live post's URL on the network, captured at publish time.
  ///
  /// Stored rather than derived because not every network's permalink can be
  /// rebuilt from `publishedId`. LinkedIn's can — it is the URN on the end of a
  /// fixed prefix. Instagram's cannot: it carries an opaque shortcode that only
  /// Meta knows, returned by a follow-up read that needs a live access token.
  /// Null for rows published before this column existed, and for any publish
  /// where the permalink lookup failed; the UI hides the link in both cases.
  permalink String? @map("permalink")

  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, provider])
  @@index([postId])
  @@index([status])
  @@map("post_platforms")
}

enum PublishStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED

  @@map("publish_status")
}

/// The publishing lifecycle of a post. Labels are lowercase in the database so
/// the existing supabase-js frontend — which reads and writes 'draft',
/// 'scheduled', 'published' as plain strings — keeps working unchanged.
/// QUEUED is new in Sprint 2: handed to the publisher, not yet in flight.
enum PostStatus {
  DRAFT      @map("draft")
  SCHEDULED  @map("scheduled")
  QUEUED     @map("queued")
  PUBLISHING @map("publishing")
  PUBLISHED  @map("published")
  FAILED     @map("failed")

  @@map("post_status")
}
