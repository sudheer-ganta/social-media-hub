# Supabase — copy this file to .env and fill in your project values.
# Find them in your Supabase dashboard under Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary — unsigned upload preset for post images.
# Dashboard → Settings → Upload → Upload presets → Add upload preset
#   Signing Mode: Unsigned
#   (Optional, enables deleting replaced images) Return delete token: ON
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Where the Express backend lives. Everything the browser can't do itself goes
# through it: OAuth connects, the integrations API, and AI caption generation.
# Defaults to http://localhost:5000 when unset.
VITE_API_BASE_URL=http://localhost:5000

# ─── There is deliberately no AI key here ────────────────────────────────────
# Anything prefixed VITE_ is compiled into the browser bundle and readable by
# anyone who opens devtools. The Gemini key lives in server/.env as
# GEMINI_API_KEY and is used only by server/src/ai/providers/gemini.provider.ts.
# If you find yourself adding VITE_GEMINI_API_KEY, stop — the endpoint you want
# is POST /api/ai/caption.
